# construction_rag — environment template
# 1. Copy this file and rename it to:  .env
# 2. Fill in your real values (no quotes needed)
# 3. NEVER commit .env to git — add it to .gitignore

# ── OpenAI (embeddings + agent LLM) ─────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here

# ── Neo4j Aura (causal graph) ───────────────────────────────────
# From your Aura console: Instances -> Connect -> Connection URI
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password-here

# ── Local stores (paths, no credentials) ────────────────────────
SQLITE_PATH=accidents.db
LANCEDB_DIR=./lancedb

# ── Optional: model overrides ───────────────────────────────────
# EMBED_MODEL=text-embedding-3-large
# AGENT_MODEL=gpt-4o
# TRANSLATE_MODEL=gpt-4o-mini
